# ---- Identifiants API OCI (Console > My profile > API keys) ----
OCI_USER_OCID=ocid1.user.oc1..xxxx
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxx
OCI_FINGERPRINT=aa:bb:cc:dd:...
OCI_REGION=eu-paris-1
# Contenu de la cle privee (PEM brut ou base64), ou chemin de fichier
OCI_KEY_CONTENT=
# OCI_KEY_FILE=./oci_api_key.pem
# OCI_KEY_PASSPHRASE=

# ---- Cible (subnet et image sont auto-detectes si vides) ----
OCI_COMPARTMENT_OCID=
OCI_SUBNET_OCID=
OCI_IMAGE_OCID=
OCI_SHAPE=VM.Standard.A1.Flex
OCI_OCPUS=4
OCI_MEMORY_GB=24
OCI_BOOT_VOLUME_GB=50
OCI_DISPLAY_NAME=free-arm-1
OCI_ASSIGN_PUBLIC_IP=true
OCI_SSH_PUBLIC_KEY=ssh-ed25519 AAAA... toi@machine
OCI_AVAILABILITY_DOMAINS=

# ---- Strategie ----
# Sonde de capacite : dit si une shape est dispo sans consommer le quota
# LaunchInstance. C'est ce qui permet de sonder toutes les 60s. Laisse a true.
CAPACITY_PROBE=true
PROBE_INTERVAL_SECONDS=60
# Tente aussi 3/18, 2/12 puis 1/6 OCPU : beaucoup plus facile a obtenir
TRY_SMALLER_SHAPES=true
# En dernier recours, prendre une E2.1.Micro AMD (presque toujours dispo)
FALLBACK_TO_MICRO=false

# ---- Rythme (mode aveugle, si la sonde est indisponible) ----
RETRY_INTERVAL_SECONDS=300
RETRY_JITTER_SECONDS=30
MAX_BACKOFF_SECONDS=3600
MAX_ATTEMPTS=0
# Utile en CI : arrete proprement le process apres N secondes
MAX_RUNTIME_SECONDS=0

# ---- Notifications (optionnel) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
